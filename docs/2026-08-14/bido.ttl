    rdfs:isDefinedBy <http://purl.org/spar/bido-review-measures/> ;
    vs:term_status reg:statusStable .

bido:core-conference-ranking a bido:ConferenceRanking,
        owl:NamedIndividual ;
    rdfs:label "CORE conference ranking"@en ;
    vann:example """
