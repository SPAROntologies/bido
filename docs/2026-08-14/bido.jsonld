  {
    "@id": "http://purl.org/spar/bido-standard-bibliometric-measures",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/elements/1.1/contributor": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "Sebastian Barzaghi (https://orcid.org/0000-0002-0799-1527)"
      }
    ],
    "http://purl.org/dc/elements/1.1/creator": [
      {
        "@value": "Silvio Peroni (http://orcid.org/0000-0003-0530-4305)"
      },
      {
        "@value": "Francesco Osborne (https://orcid.org/0000-0001-6557-3131)"
      },
      {
        "@value": "Enrico Motta (https://orcid.org/0000-0003-0015-1952)"
      }
    ],
    "http://purl.org/dc/elements/1.1/date": [
      {
        "@value": "2026-09-13"
      }
    ],
    "http://purl.org/dc/elements/1.1/description": [
      {
        "@language": "en",
        "@value": "\nThis module of BiDO describes a list of possible bibliometric measures tha can be used to define bibliometric data of publication-related entities, e.g.: h-index, e-index, journal impact factor, author citation count.\n\n![The architecture of the BiDO-Standard-Bibliometric-Measures module.](bido-standard-bibliometric-measures.png)\n\n"
      }
    ],
    "http://purl.org/dc/elements/1.1/title": [
      {
        "@value": "BiDO Standard Bibliometric Measures module (BiDO-Standard-Bibliometric-Measures)"
      }
    ],
    "http://purl.org/dc/terms/bibliographicCitation": [
      {
        "@value": "Osborne, F., Peroni, S., Motta, E. (2014). Clustering Citation Distributions for Semantic Categorization and Citation Prediction. In Proceedings of the 4th Workshop on Linked Science (LISC 2014): 24–35. http://ceur-ws.org/Vol-1282/lisc2014_submission_9.pdf"
      }
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@value": "2015-07-15"
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@value": "2015-07-15"
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "http://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@value": "2026-09-13"
      }
    ],
    "http://purl.org/dc/terms/publisher": [
      {
        "@id": "https://ror.org/00wb4mk85"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://github.com/SPAROntologies/bido/blob/master/docs/cq.md"
      }
    ],
    "http://purl.org/ontology/bibo/doi": [
      {
        "@value": "https://doi.org/10.25504/FAIRsharing.d7f0a9"
      }
    ],
    "http://purl.org/ontology/bibo/status": [
      {
        "@id": "http://purl.org/ontology/bibo/status/published"
      }
    ],
    "http://purl.org/vocab/vann/changes": [
      {
        "@language": "en",
        "@value": "\n* **v1.1.1**: Added new documentation, including annotation properties (e.g., `bibo:doi`, `schema:codeRepository`, etc.), term properties (e.g., `vann:example`, `vs:term_status`, etc.), exemplary competency questions with their respective SPARQL queries, and a Grafoo diagram.\n* **v1.1.2**: Fixed `tvc:atTime` range, adding `time:TemporalEntity`.\n    "
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@language": "en",
        "@value": "bido"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespaceUri": [
