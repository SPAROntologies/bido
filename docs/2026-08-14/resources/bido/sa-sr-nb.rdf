<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/spar/bido/sa-sr-nb">
    <rdfs:comment xml:lang="en">Discrete scale from Strong Reject to Strong Accept, excluding Bordeline</rdfs:comment>
    <vann:example>
    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;
        tvc:atTime :my-time-interval ;
        bido:accordingTo :my-organization ;
        bido:withBibliometricData bido:sa-sr-nb-sacc .

    bido:sa-sr-nb-sacc
        bido:isDefinedIn bido:sa-sr-nb .
    </vann:example>
    <rdf:type rdf:resource="http://purl.org/spar/bido/DiscreteReviewRatingScale"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:label xml:lang="en">Strong Reject to Strong Accept, without Borderline review rating scale</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/bido-review-measures/"/>
  </rdf:Description>
</rdf:RDF>
