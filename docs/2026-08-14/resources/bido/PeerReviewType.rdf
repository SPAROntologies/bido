  <rdf:Description rdf:nodeID="N5f11a94105d947788d25d314127846e3">
    <owl:inverseOf rdf:resource="http://purl.org/spar/bido/withBibliometricData"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/spar/bido/PeerReviewType">
    <rdfs:comment xml:lang="en">A type of of peer review process, such as 'double-blind' or 'open'.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="N7466940061e748faa4dea3c7d393a2b8"/>
    <rdfs:subClassOf rdf:resource="http://purl.org/spar/bido/CategorialBibliometricData"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <vann:example>
    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;
        tvc:atTime :my-time-interval ;
        bido:accordingTo :my-organization ;
        bido:withBibliometricData bido:double-blind-peer-review .

    :double-blind-peer-review a bido:PeerReviewType .
    </vann:example>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/bido-review-measures/"/>
    <rdfs:label xml:lang="en">peer review type</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
