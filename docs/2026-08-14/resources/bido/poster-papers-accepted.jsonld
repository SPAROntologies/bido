    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-academic-event a swc:AcademicEvent ;\n        bido:holdsBibliometricDataInTime :my-bibliometric-data-in-time .\n\n    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;\n        tvc:atTime :my-time-interval ;\n        bido:accordingTo :my-organization ;\n        bido:withBibliometricData :my-numeric-bibliometric-data .\n\n    :my-numeric-bibliometric-data a bido:NumericBibliometricData ;\n        bido:hasMeasure bido:poster-papers-accepted ;\n        bido:hasNumericValue \"25\"^^xsd:float .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A measure indicating how many poster papers has been accepted for publication/presentation in the venue."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
