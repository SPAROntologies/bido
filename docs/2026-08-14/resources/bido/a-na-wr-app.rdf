<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:bido="http://purl.org/spar/bido/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/spar/bido/a-na-wr-app">
    <vann:example>
    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;
        tvc:atTime :my-time-interval ;
        bido:accordingTo :my-organization ;
        bido:withBibliometricData bido:a-na-wr-app .
    </vann:example>
    <bido:isDefinedIn rdf:resource="http://purl.org/spar/bido/a-na-wr"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/bido/sa-sr-nb-sacc"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/bido/dis-n2-p2-pos2"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/bido/dis-0-10-10"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/bido/sa-sr-bl-acc"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/bido/dis-0-5-5"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/bido/dis-0-5-4"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/bido/sa-sr-bl-sacc"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/bido/dis-n2-p2-pos1"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/bido/a-r-ts-acc"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/bido/sa-sr-nb-acc"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://purl.org/spar/bido/ReviewRatingValue"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/bido-review-measures/"/>
    <rdfs:label xml:lang="en">Approved (Approved to Not Approved review rating scale)</rdfs:label>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:comment xml:lang="en">The value 'Approved' in a discrete scale from 'Approved' to 'Not Approved' for review rating.</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
