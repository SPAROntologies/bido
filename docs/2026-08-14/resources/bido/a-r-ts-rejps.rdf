<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:bido="http://purl.org/spar/bido/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/spar/bido/a-r-ts-rejps">
    <rdfs:label xml:lang="en">Reject, Pre-Screening (Accept to Reject, Two Strikes review rating scale)</rdfs:label>
    <bido:isDefinedIn rdf:resource="http://purl.org/spar/bido/a-r-ts"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/bido-review-measures/"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdf:type rdf:resource="http://purl.org/spar/bido/ReviewRatingValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment xml:lang="en">The value 'Reject, Pre-Screening' in a discrete scale from 'Accept' to 'Reject, Two Strikes' for review rating.</rdfs:comment>
    <vann:example>
    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;
        tvc:atTime :my-time-interval ;
        bido:accordingTo :my-organization ;
        bido:withBibliometricData bido:a-r-ts-rejps .
    </vann:example>
  </rdf:Description>
</rdf:RDF>
