<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:bido="http://purl.org/spar/bido/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/spar/bido/core-b">
    <bido:isDefinedIn rdf:resource="http://purl.org/spar/bido/core-conference-ranking"/>
    <vann:example>
    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;
        tvc:atTime :my-time-interval ;
        bido:accordingTo :my-organization ;
        bido:withBibliometricData bido:core-b .
    </vann:example>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/bido-review-measures/"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:comment xml:lang="en">The CORE category for a good conference, and well regarded in a discipline area.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://purl.org/spar/bido/ConferenceRankingCategory"/>
    <bido:isHigherThan rdf:resource="http://purl.org/spar/bido/core-c"/>
    <rdfs:label>B</rdfs:label>
  </rdf:Description>
</rdf:RDF>
