  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/spar/bido/full-papers-accepted">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:nodeID="Na04e99ecb3864102935954b40ea58a33"/>
    <rdf:type rdf:resource="http://purl.org/spar/bido/BibliometricMeasure"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <vann:example>
    :my-academic-event a swc:AcademicEvent ;
        bido:holdsBibliometricDataInTime :my-bibliometric-data-in-time .

    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;
        tvc:atTime :my-time-interval ;
        bido:accordingTo :my-organization ;
        bido:withBibliometricData :my-numeric-bibliometric-data .

    :my-numeric-bibliometric-data a bido:NumericBibliometricData ;
        bido:hasMeasure bido:full-papers-accepted ;
        bido:hasNumericValue "30"^^xsd:float .
    </vann:example>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/bido-review-measures/"/>
    <rdfs:comment>A measure indicating how many full papers has been accepted for publication or presentation in the venue.</rdfs:comment>
    <rdfs:label>number of full paper accepted</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7ada2105558a48068725a659dfe44921">
