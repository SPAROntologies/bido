<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:bido="http://purl.org/spar/bido/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/spar/bido/dis-0-10-3">
    <rdfs:label xml:lang="en">3 out of 10 (Discrete 0 to 10 review rating scale)</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/bido-review-measures/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://purl.org/spar/bido/ReviewRatingValue"/>
    <rdfs:comment xml:lang="en">The value 3 in a discrete scale from 0 to 10 for review rating.</rdfs:comment>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <bido:isDefinedIn rdf:resource="http://purl.org/spar/bido/dis-0-10"/>
    <bido:hasRatingValue rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</bido:hasRatingValue>
    <vann:example>
    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;
        tvc:atTime :my-time-interval ;
        bido:accordingTo :my-organization ;
        bido:withBibliometricData bido:dis-0-10-3 .
    </vann:example>
  </rdf:Description>
</rdf:RDF>
