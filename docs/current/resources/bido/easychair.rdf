<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/spar/bido/easychair">
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/bido-review-measures/"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:label>EasyChair</rdfs:label>
    <vann:example>
    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;
        tvc:atTime :my-time-interval ;
        bido:accordingTo :my-organization ;
        bido:withBibliometricData bido:easychair .
    </vann:example>
    <rdf:type rdf:resource="http://purl.org/spar/bido/ScholarlyVenueManagementSystem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:comment>A conference management system that is flexible, easy to use, and has many features to make it suitable for various conference models. It is currently probably the most commonly used conference management system.</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
