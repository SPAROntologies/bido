[
  {
    "@id": "http://purl.org/spar/bido/to-15-continuous",
    "@type": [
      "http://purl.org/spar/bido/ReviewRatingScale",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;\n        tvc:atTime :my-time-interval ;\n        bido:accordingTo :my-organization ;\n        bido:withBibliometricData :my-review-rating-value .\n\n    :my-review-rating-value        \n        bido:isDefinedIn bido:to-15-continuous .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A continuous review rating scale, ranging from 0 to 15."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://purl.org/spar/bido-review-measures/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "0 to 15 continuos review rating scale"
      }
    ],
    "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status": [
      {
        "@id": "http://purl.org/linked-data/registry#statusStable"
      }
    ]
  }
]