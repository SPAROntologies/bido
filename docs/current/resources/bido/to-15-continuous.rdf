<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/spar/bido/to-15-continuous">
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/bido-review-measures/"/>
    <rdfs:label xml:lang="en">0 to 15 continuos review rating scale</rdfs:label>
    <rdf:type rdf:resource="http://purl.org/spar/bido/ReviewRatingScale"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <vann:example>
    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;
        tvc:atTime :my-time-interval ;
        bido:accordingTo :my-organization ;
        bido:withBibliometricData :my-review-rating-value .

    :my-review-rating-value        
        bido:isDefinedIn bido:to-15-continuous .
    </vann:example>
    <rdfs:comment xml:lang="en">A continuous review rating scale, ranging from 0 to 15.</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
