  <rdf:Description rdf:nodeID="N4711a36e4f3747498ec0d0065a106e0d">
    <owl:allValuesFrom rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <owl:onProperty rdf:nodeID="N3f46b8f673d043a2a93fc77ba3c98199"/>
