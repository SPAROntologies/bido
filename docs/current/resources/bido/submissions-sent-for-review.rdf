  <rdf:Description rdf:about="http://purl.org/spar/bido/submissions-sent-for-review">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:nodeID="N24def708828848a19dc61ed4a9cceba7"/>
    <rdf:type rdf:resource="http://purl.org/spar/bido/BibliometricMeasure"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/bido-review-measures/"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <vann:example>
    :my-academic-event a swc:AcademicEvent ;
        bido:holdsBibliometricDataInTime :my-bibliometric-data-in-time .

    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;
        tvc:atTime :my-time-interval ;
        bido:accordingTo :my-organization ;
        bido:withBibliometricData :my-numeric-bibliometric-data .

    :my-numeric-bibliometric-data a bido:NumericBibliometricData ;
        bido:hasMeasure bido:submissions-sent-for-review ;
        bido:hasNumericValue "200"^^xsd:float .
    </vann:example>
    <rdfs:comment xml:lang="en">The number of submitted papers assigned to reviewers for revision.</rdfs:comment>
    <rdfs:label xml:lang="en">number of submission sent for review</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N06e6cf2b096341e3b93d75f82d94df27">
    <owl:inverseOf rdf:resource="http://purl.org/spar/bido/hasMeasure"/>
  </rdf:Description>
