    <owl:onProperty rdf:nodeID="N1a22b6c4be424ff9a4a442ef820168fc"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N12483d12a7814146b8a56000e7b8f9b5">
    <owl:inverseOf rdf:resource="http://purl.org/spar/bido/withBibliometricData"/>
