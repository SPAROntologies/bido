>
  <rdf:Description rdf:about="http://purl.org/spar/bido/sa-sr-nb-rej">
    <skos:closeMatch rdf:resource="http://purl.org/spar/bido/dis-0-10-0"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/bido/a-na-wr-napp"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/bido/a-r-ts-rej"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/bido/dis-0-5-1"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/bido/dis-n2-p2-neg1"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/bido/sa-sr-bl-rej"/>
    <bido:isDefinedIn rdf:resource="http://purl.org/spar/bido/sa-sr-nb"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/bido-review-measures/"/>
    <rdf:type rdf:resource="http://purl.org/spar/bido/ReviewRatingValue"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <vann:example>
    :my-bibliometric-data-in-time a bido:BibliometricDataInTime ;
        tvc:atTime :my-time-interval ;
        bido:accordingTo :my-organization ;
        bido:withBibliometricData bido:sa-sr-nb-rej .
    </vann:example>
    <rdfs:label xml:lang="en">Reject (Strong Reject to Strong Accept, without Borderline review rating scale)</rdfs:label>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:comment xml:lang="en">The value 'Reject' in a scale from 'Strong Accept' to 'Strong Accept' for review rating.</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
